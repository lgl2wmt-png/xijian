{
  "name": "xijian",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c teal,amber \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "vite --port 5188 --strictPort --host 127.0.0.1",
    "dev:api": "tsx server/index.ts",
    "seed": "tsx server/seed.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "screenshots": "node scripts/screenshots.mjs",
    "to-webp": "node scripts/to-webp.mjs",
    "prepare-hero": "node scripts/prepare-hero.mjs",
    "gen-icons": "node scripts/gen-icons.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "deploy:vercel": "vercel --prod",
    "promo:video": "node scripts/make-promo-video.mjs",
    "promo:preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "antd": "^6.6.6",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "echarts": "^6.0.0",
    "express": "^5.2.1",
    "i18next": "^26.5.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.1.0",
    "react-router-dom": "^7.18.4",
    "ws": "^8.20.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  }
